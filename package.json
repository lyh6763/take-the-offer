{
  "name": "take-the-offer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0 --cache --cache-location node_modules/.cache/stylelint/"
  },
  "dependencies": {
    "@fontsource/anton": "^5.2.0",
    "@fontsource/black-han-sans": "^5.2.0",
    "@fontsource/do-hyeon": "^5.2.0",
    "@fontsource/jua": "^5.2.0",
    "@fontsource/nanum-myeongjo": "^5.2.0",
    "@fontsource/song-myung": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  }
}
